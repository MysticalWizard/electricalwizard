{
  "name": "electricalwizard",
  "version": "3.2.0",
  "description": "A Discord bot secretary for the n-th circle of hell.",
  "type": "module",
  "main": "dist/main.js",
  "author": "MysticalWizard",
  "private": true,
  "scripts": {
    "dev": "NODE_ENV=development tsx src/main.ts",
    "watch": "NODE_ENV=development tsx watch src/main.ts",
    "build": "rimraf dist && tsc && tsc-alias",
    "start": "NODE_ENV=production node dist/main.js",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "register": "pnpm run build && NODE_ENV=production node dist/register.js",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:watch": "pm2 start ecosystem.config.cjs --watch",
    "pm2:stop": "pm2 stop electricalwizard",
    "pm2:restart": "pm2 restart electricalwizard",
    "pm2:delete": "pm2 delete electricalwizard",
    "prepare": "husky"
  },
  "dependencies": {
    "chalk": "^5.6.0",
    "dayjs": "^1.11.13",
    "discord.js": "^14.21.0",
    "dotenv": "^16.6.1",
    "mongoose": "^8.17.1"
  },
  "devDependencies": {
    "@types/node": "^22.17.2",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "pm2": "^6.0.8",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2"
  },
  "packageManager": "pnpm@10.11.0+sha512.6540583f41cc5f628eb3d9773ecee802f4f9ef9923cc45b69890fb47991d4b092964694ec3a4f738a420c918a333062c8b925d312f42e4f0c263eb603551f977"
}
