{
  "name": "electricalwizard",
  "version": "3.2.0",
  "description": "A Discord bot secretary for the n-th circle of hell.",
  "type": "module",
  "main": "dist/main.js",
  "author": "MysticalWizard",
  "private": true,
  "scripts": {
    "dev": "NODE_ENV=development tsx src/main.ts",
    "watch": "NODE_ENV=development tsx watch src/main.ts",
    "build": "rimraf dist && tsc && tsc-alias",
    "start": "NODE_ENV=production node dist/main.js",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "register": "pnpm run build && NODE_ENV=production node dist/register.js",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:watch": "pm2 start ecosystem.config.cjs --watch",
    "pm2:stop": "pm2 stop electricalwizard",
    "pm2:restart": "pm2 restart electricalwizard",
    "pm2:delete": "pm2 delete electricalwizard",
    "prepare": "husky"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "dayjs": "^1.11.13",
    "discord.js": "^14.19.1",
    "dotenv": "^16.5.0",
    "mongoose": "^8.14.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.2",
    "@typescript-eslint/eslint-plugin": "^8.31.0",
    "@typescript-eslint/parser": "^8.31.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "husky": "^9.1.7",
    "pm2": "^6.0.5",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "tsc-alias": "^1.8.15",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@10.7.0+sha512.6b865ad4b62a1d9842b61d674a393903b871d9244954f652b8842c2b553c72176b278f64c463e52d40fff8aba385c235c8c9ecf5cc7de4fd78b8bb6d49633ab6"
}
