{
  "name": "electricalwizard",
  "version": "3.2.0",
  "description": "A Discord bot secretary for the n-th circle of hell.",
  "type": "module",
  "main": "dist/main.js",
  "author": "MysticalWizard",
  "private": true,
  "scripts": {
    "dev": "NODE_ENV=development tsx src/main.ts",
    "watch": "NODE_ENV=development tsx watch src/main.ts",
    "build": "rimraf dist && tsc && tsc-alias",
    "start": "NODE_ENV=production node dist/main.js",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "register": "pnpm run build && NODE_ENV=production node dist/register.js",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:watch": "pm2 start ecosystem.config.cjs --watch",
    "pm2:stop": "pm2 stop electricalwizard",
    "pm2:restart": "pm2 restart electricalwizard",
    "pm2:delete": "pm2 delete electricalwizard",
    "prepare": "husky"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "dayjs": "^1.11.19",
    "discord.js": "^14.24.2",
    "dotenv": "^16.6.1",
    "mongoose": "^8.19.4"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "pm2": "^6.0.13",
    "prettier": "^3.6.2",
    "rimraf": "^6.1.0",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.20.0+sha512.cf9998222162dd85864d0a8102e7892e7ba4ceadebbf5a31f9c2fce48dfce317a9c53b9f6464d1ef9042cba2e02ae02a9f7c143a2b438cd93c91840f0192b9dd"
}
