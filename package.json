{
  "name": "electricalwizard",
  "version": "4.0.0",
  "type": "module",
  "description": "A Discord bot secretary for the n-th circle of hell.",
  "main": "dist/main.js",
  "imports": {
    "#/*": {
      "development": "./src/*",
      "default": "./dist/*"
    }
  },
  "author": "MysticalWizard",
  "private": true,
  "scripts": {
    "dev": "tsx watch --conditions=development src/main.ts",
    "dev:bot": "tsx watch --conditions=development src/main.ts",
    "dev:dashboard": "pnpm --filter @electricalwizard/dashboard dev",
    "dev:all": "concurrently \"pnpm dev:bot\" \"pnpm dev:dashboard\"",
    "watch": "tsc --watch",
    "build": "tsc",
    "build:dashboard": "pnpm --filter @electricalwizard/dashboard build",
    "build:all": "tsc && pnpm --filter @electricalwizard/dashboard build",
    "start": "NODE_ENV=production node dist/main.js",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs",
    "pm2:logs": "pm2 logs ecosystem.config.cjs",
    "pm2:delete": "pm2 delete ecosystem.config.cjs",
    "deploy": "tsx --conditions=development src/deploy.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:all": "eslint . && pnpm --filter @electricalwizard/dashboard lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "chalk": "^6.0.0",
    "dayjs": "^1.11.23",
    "discord.js": "^14.27.0",
    "hono": "^4.13.9",
    "mongoose": "^9.10.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.1"
  },
  "lint-staged": {
    "*.{ts,mjs}": "eslint --fix",
    "*.{ts,mjs,json,md}": "prettier --write"
  },
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec"
}
