{
  "name": "electricalwizard",
  "version": "4.0.0",
  "type": "module",
  "description": "A Discord bot secretary for the n-th circle of hell.",
  "main": "dist/main.js",
  "imports": {
    "#/*": {
      "development": "./src/*",
      "default": "./dist/*"
    }
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.14.0",
      "onFail": "error"
    }
  },
  "author": "MysticalWizard",
  "private": true,
  "scripts": {
    "dev": "tsx watch --conditions=development src/main.ts",
    "dev:bot": "tsx watch --conditions=development src/main.ts",
    "dev:web": "tsx watch --conditions=development src/web/index.ts",
    "dev:dashboard": "pnpm --filter @electricalwizard/dashboard dev",
    "dev:all": "concurrently \"pnpm dev:bot\" \"pnpm dev:web\" \"pnpm dev:dashboard\"",
    "watch": "tsc --watch",
    "build": "tsc",
    "build:dashboard": "pnpm --filter @electricalwizard/dashboard build",
    "build:all": "tsc && pnpm --filter @electricalwizard/dashboard build",
    "start": "NODE_ENV=production node dist/main.js",
    "start:web": "NODE_ENV=production node dist/web/index.js",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs",
    "pm2:logs": "pm2 logs ecosystem.config.cjs",
    "pm2:delete": "pm2 delete ecosystem.config.cjs",
    "deploy": "node dist/deploy.js",
    "deploy:dev": "tsx --conditions=development src/deploy.ts",
    "db:backup": "bash scripts/backup-db.sh",
    "db:export": "bash scripts/export-db.sh",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:all": "eslint . && pnpm --filter @electricalwizard/dashboard lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "chalk": "^6.0.1",
    "dayjs": "^1.11.23",
    "discord.js": "^14.27.0",
    "hono": "^4.13.13",
    "mongoose": "^9.11.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.1"
  },
  "lint-staged": {
    "*.{ts,mjs}": "eslint --fix",
    "*.{ts,mjs,json,md}": "prettier --write"
  },
  "packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9"
}
