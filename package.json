{
  "name": "electricalwizard",
  "version": "4.0.0",
  "type": "module",
  "description": "A Discord bot secretary for the n-th circle of hell.",
  "main": "dist/main.js",
  "author": "MysticalWizard",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:bot": "tsx watch src/main.ts",
    "dev:dashboard": "pnpm --filter @electricalwizard/dashboard dev",
    "dev:all": "concurrently \"pnpm dev:bot\" \"pnpm dev:dashboard\"",
    "watch": "tsc --watch",
    "build": "tsc && tsc-alias",
    "build:dashboard": "pnpm --filter @electricalwizard/dashboard build",
    "build:all": "tsc && tsc-alias && pnpm --filter @electricalwizard/dashboard build",
    "start": "NODE_ENV=production node dist/main.js",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs",
    "pm2:logs": "pm2 logs ecosystem.config.cjs",
    "pm2:delete": "pm2 delete ecosystem.config.cjs",
    "deploy": "tsx src/deploy.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:all": "eslint . && pnpm --filter @electricalwizard/dashboard lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "chalk": "^5.6.2",
    "dayjs": "^1.11.21",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "hono": "^4.13.2",
    "mongoose": "^9.9.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.13.3",
    "concurrently": "^9.2.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "lint-staged": {
    "*.{ts,mjs}": "eslint --fix",
    "*.{ts,mjs,json,md}": "prettier --write"
  },
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1"
}
