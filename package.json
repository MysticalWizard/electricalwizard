{
  "name": "electricalwizard",
  "version": "4.0.0",
  "type": "module",
  "description": "A Discord bot secretary for the n-th circle of hell.",
  "main": "dist/main.js",
  "author": "MysticalWizard",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "watch": "tsc --watch",
    "build": "tsc && tsc-alias",
    "start": "node dist/main.js",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop electricalwizard",
    "pm2:restart": "pm2 restart electricalwizard",
    "pm2:logs": "pm2 logs electricalwizard",
    "pm2:delete": "pm2 delete electricalwizard",
    "deploy": "tsx src/deploy.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "dayjs": "^1.11.20",
    "discord.js": "^14.25.1",
    "dotenv": "^17.3.1",
    "mongoose": "^9.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2"
  },
  "lint-staged": {
    "*.{ts,mjs}": "eslint --fix",
    "*.{ts,mjs,json,md}": "prettier --write"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
