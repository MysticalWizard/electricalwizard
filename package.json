{
  "name": "electricalwizard",
  "version": "4.0.0",
  "type": "module",
  "description": "A Discord bot secretary for the n-th circle of hell.",
  "main": "dist/main.js",
  "author": "MysticalWizard",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:bot": "tsx watch src/main.ts",
    "dev:dashboard": "pnpm --filter @electricalwizard/dashboard dev",
    "dev:all": "concurrently \"pnpm dev:bot\" \"pnpm dev:dashboard\"",
    "watch": "tsc --watch",
    "build": "tsc && tsc-alias",
    "build:dashboard": "pnpm --filter @electricalwizard/dashboard build",
    "build:all": "tsc && tsc-alias && pnpm --filter @electricalwizard/dashboard build",
    "start": "NODE_ENV=production node dist/main.js",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs",
    "pm2:logs": "pm2 logs ecosystem.config.cjs",
    "pm2:delete": "pm2 delete ecosystem.config.cjs",
    "deploy": "tsx src/deploy.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.14",
    "chalk": "^5.6.2",
    "dayjs": "^1.11.21",
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "hono": "^4.12.23",
    "mongoose": "^9.6.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.4",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.1"
  },
  "lint-staged": {
    "*.{ts,mjs}": "eslint --fix",
    "*.{ts,mjs,json,md}": "prettier --write"
  },
  "packageManager": "pnpm@11.5.1+sha512.93f7b57422ea7068257235b4c16eb60762eb68e1dc23723199cc739043ea9be2c4143274a399d8c6defa2b1176226d9ca1c4b63482d6200c1a8fbaa78c1d1485"
}
